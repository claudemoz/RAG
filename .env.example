# Génération : anthropic ou openai
LLM_PROVIDER=anthropic
LLM_MODEL=identifiant du modèle Claude choisi

# Embeddings : transformers (local, sans clé), openai ou voyage
EMBEDDING_PROVIDER=transformers
EMBEDDING_MODEL=identifiant du modèle d'embedding

# Clés d'API : seules celles des fournisseurs choisis sont requises
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=